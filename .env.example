# Copy to .env and adjust. Every value below is already the default.

# ---------------------------------------------------------------------------
# Chat model. This single value swaps the provider; nothing else changes.
# ---------------------------------------------------------------------------
# Local via Ollama (free, offline, what the assignment brief names). Use the
# "ollama_chat/" prefix, not "ollama/" -- the chat path gives much better
# tool-calling behaviour.
HELPDESK_MODEL=ollama_chat/qwen3:8b
#   ollama_chat/llama3.1:8b
#   ollama_chat/mistral:7b
#
# Hosted via Groq -- runs open-weight models with no local download. Verified
# working with this project (incl. the reasoning-model fix in build_model()):
#   HELPDESK_MODEL=groq/openai/gpt-oss-20b        verified; free-tier cap 8000 tok/min
#   HELPDESK_MODEL=groq/qwen/qwen3.8-27b          same Qwen3 family as the local
#                                                 default; tighter cap (7000 tok/min)
# Groq retires model ids often -- llama-3.1-8b-instant and llama-3.3-70b-versatile
# were both pulled from the catalog during this project. List the live ones with:
#   curl -s https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $GROQ_API_KEY" | python -m json.tool
#
# Other hosted providers work identically:
#   HELPDESK_MODEL=openai/gpt-4.1-mini
#   HELPDESK_MODEL=anthropic/claude-sonnet-4-5

# API key for the hosted provider, needed only if HELPDESK_MODEL is not Ollama.
# Get a Groq key (free tier) from https://console.groq.com/keys
# Put the real value in .env, not here -- this file is the committed template.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings. Independent of the chat model -- hosted chat providers such as
# Groq do not offer embeddings, so RAG always needs one of these two.
# ---------------------------------------------------------------------------
#   ollama -- nomic-embed-text through Ollama (768 dims, needs a running server)
#   local  -- ChromaDB's bundled all-MiniLM-L6-v2 ONNX model (384 dims, no
#             server at all; downloads ~80 MB once). Use this with a hosted chat
#             model to run the project without installing Ollama.
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text

# Ollama server, used by the ollama chat models and the ollama embedding backend
OLLAMA_HOST=http://localhost:11434

# Retrieval tuning
TOP_K=5
CANDIDATE_K=20
CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=200

# Cosine distance above which the corpus is treated as having no answer, which
# drives a refusal. Leave unset to use the measured per-backend default
# (0.55 for "local", 0.62 for "ollama"). Raise it to refuse less, lower it to
# refuse more; re-check with `python eval/check_retrieval.py` after changing it.
# MAX_RELEVANT_DISTANCE=0.55

# Set to 1 to make `adk web` / `adk run` load the single-agent baseline instead
# of the multi-agent graph.
# HELPDESK_SINGLE_AGENT=1
