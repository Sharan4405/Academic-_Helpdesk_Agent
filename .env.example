# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Chat model (LiteLLM string). Hosted on Groq:
HELPDESK_MODEL=groq/qwen/qwen3.8-27b
GROQ_API_KEY=
# Local alternatives (need Ollama): ollama_chat/qwen3:8b, ollama_chat/llama3.1:8b

# Embeddings. "local" = ChromaDB's bundled all-MiniLM-L6-v2 (no server). The
# pre-embedded index in data1/chroma was built with this model, so queries must use it.
EMBEDDING_BACKEND=local

# Corpus: prebuilt (data1/chroma), raw (data1/raw via rag.extract), synthetic, all
CORPUS_SOURCE=prebuilt

# Vector store: chroma (default) or numpy (exact search, no native index; use it if
# ChromaDB crashes on your machine)
VECTOR_BACKEND=numpy

# Retrieval. Small values keep each request inside free-tier token limits.
TOP_K=3
PASSAGE_MAX_CHARS=1000
MAX_RELEVANT_DISTANCE=0.50
